# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required ---

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/launchproof?schema=public"

# The canonical origin of the deployment.
NEXTAUTH_URL="http://localhost:3000"

# Session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""


# --- Optional ---
# The app runs without these. Analysis features surface a clear
# "not configured" message rather than failing, and project plans fall back
# to deterministic templates.

# Job and résumé analysis.
OPENAI_API_KEY=""

# GitHub sign-in and repository evidence sync.
# Create at: https://github.com/settings/developers
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google sign-in.
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Résumé storage. Leave unset to store uploads on local disk (development,
# or any host with a persistent volume). REQUIRED on serverless platforms
# such as Vercel, where the filesystem is ephemeral and an uploaded file
# will not survive to the next request.
BLOB_READ_WRITE_TOKEN=""
