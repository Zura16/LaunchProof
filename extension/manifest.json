{
  "manifest_version": 3,
  "name": "LaunchProof - Job Saver & Skill Matcher",
  "version": "1.0.0",
  "description": "Save job listings directly to LaunchProof and instantly view recurring target market skill matches.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://launchproof.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
