datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Authentication Models (Auth.js / NextAuth)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  profile         StudentProfile?
  resumes         Resume[]
  githubAccount   GitHubAccount?
  savedJobs       SavedJob[]
  evidences       Evidence[]
  studentSkills   StudentSkill[]
  applications    Application[]
  projectPlans    ProjectPlan[]
  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Student Profile
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName              String
  university            String
  degree                String
  major                 String
  graduationDate        DateTime
  academicYear          String // FRESHMAN, SOPHOMORE, JUNIOR, SENIOR, GRADUATE
  preferredJobTypes     String[] // INTERNSHIP, NEW_GRAD, FULL_TIME
  preferredLocations    String[]
  remotePreference      String // IN_PERSON, HYBRID, REMOTE, ANY
  workAuthorization     String // US_CITIZEN, GREEN_CARD, F1_OPT, CPT, OTHER
  sponsorshipRequired   Boolean   @default(false)
  targetRoleCategories  String[] // SWE, BACKEND, FRONTEND, FULLSTACK, MOBILE, DATA
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Skill System
enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  DEVOPS
  TESTING
  CONCEPT
  TOOL
  OTHER
}

model Skill {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  category        SkillCategory
  description     String?
  aliases         SkillAlias[]
  studentSkills   StudentSkill[]
  jobRequirements JobRequirement[]
  evidences       Evidence[]
  gaps            SkillGap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillAlias {
  id      String @id @default(cuid())
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias   String @unique
}

// Evidence Engine
enum EvidenceStrength {
  STRONG
  MODERATE
  WEAK
  SELF_REPORTED
  MISSING
}

enum EvidenceSourceType {
  GITHUB_REPOSITORY
  RESUME_PROJECT
  WORK_EXPERIENCE
  COURSEWORK
  MANUAL
  PORTFOLIO
  DEPLOYED_APP
}

model Evidence {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  sourceType  EvidenceSourceType
  sourceId    String? // Reference to repo ID, resume project ID, or work experience ID
  strength    EvidenceStrength
  description String
  evidenceUrl String?
  metadata    Json? // File citations, commit counts, line counts, imports

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentSkill {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  highestStrength EvidenceStrength @default(SELF_REPORTED)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
}

// Résumé System
model Resume {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  rawText       String @db.Text
  parsedContent Json?

  experiences Experience[]
  projects    ResumeProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String?
  endDate     String?
  description String   @db.Text
  bullets     String[]
  skillsUsed  String[]
}

model ResumeProject {
  id           String   @id @default(cuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title        String
  role         String?
  description  String   @db.Text
  bullets      String[]
  technologies String[]
  repoUrl      String?
  liveUrl      String?
}

// GitHub Integration
model GitHubAccount {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  avatarUrl   String?
  profileUrl  String
  accessToken String? // Encrypted at rest

  repositories GitHubRepository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitHubRepository {
  id              String        @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  name            String
  fullName        String
  description     String?
  isFork          Boolean       @default(false)
  stars           Int           @default(0)
  forks           Int           @default(0)
  languages       Json // e.g. { "TypeScript": 15000, "CSS": 2000 }
  primaryLanguage String?
  topics          String[]
  repoUrl         String
  defaultBranch   String        @default("main")
  analysisResult  Json? // Extracted frameworks, libraries, tests, Docker, CI details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Job System
enum RequirementType {
  REQUIRED
  PREFERRED
  RESPONSIBILITY
  ELIGIBILITY
}

enum RequirementImportance {
  HIGH
  MEDIUM
  LOW
}

model JobPosting {
  id              String  @id @default(cuid())
  company         String
  title           String
  location        String?
  url             String?
  description     String  @db.Text
  rawRequirements Json?

  requirements JobRequirement[]
  savedJobs    SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobRequirement {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  type       RequirementType       @default(REQUIRED)
  importance RequirementImportance @default(HIGH)
  rawMention String? // Original phrase as it appeared in the posting
  confidence Float                 @default(1) // Extraction confidence, 0-1

  createdAt DateTime @default(now())
}

model SavedJob {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  notes       String?
  application Application?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobPostingId])
}

// Skill Gap & Action Recommendation Engine
model SkillGap {
  id      String @id @default(cuid())
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  marketCount     Int // How many target saved jobs require/prefer it
  marketPercent   Float // Percentage of saved jobs
  currentEvidence EvidenceStrength
  priorityScore   Float // Deterministic computed score
  explanation     String           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RecommendationType {
  IMPROVE_EXISTING_PROJECT
  BUILD_NEW_PROJECT
  ADD_TESTING
  DEPLOY_PROJECT
  IMPROVE_DOCUMENTATION
  ADD_DATABASE
  ADD_CICD
  STRENGTHEN_RESUME
  APPLY_NOW
}

enum RecommendationImpact {
  HIGH
  MEDIUM
  LOW
}

// A Recommendation is the deterministic-ranked, AI-explained bridge between
// SkillGaps and an actionable ProjectPlan. Ranking inputs (market frequency,
// required/preferred counts, evidence gap) are computed in application code;
// only the resulting explanation text is AI-generated.
model Recommendation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            RecommendationType
  impact          RecommendationImpact
  title           String
  reasoning       String               @db.Text
  skillsAddressed String[] // Skill names this recommendation creates evidence for
  targetRepoName  String? // Existing repo this recommendation targets, if any
  priorityScore   Float // Deterministic score used for ranking
  status          String               @default("ACTIVE") // ACTIVE, DISMISSED, COMPLETED

  projectPlan ProjectPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectDifficulty {
  SMALL
  MEDIUM
  LARGE
}

model ProjectPlan {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?         @unique
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  title          String
  objective      String            @db.Text
  whyItMatters   String            @db.Text
  difficulty     ProjectDifficulty @default(MEDIUM)
  targetRepoName String? // Existing repo to upgrade OR new repo name
  skillsTargeted String[] // Skill names

  milestones       ProjectMilestone[]
  definitionOfDone String[]
  expectedEvidence String[]
  status           String             @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMilestone {
  id            String      @id @default(cuid())
  projectPlanId String
  projectPlan   ProjectPlan @relation(fields: [projectPlanId], references: [id], onDelete: Cascade)

  title       String
  description String   @db.Text
  tasks       String[]
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
}

// Application Tracking
enum ApplicationStatus {
  SAVED
  PREPARING
  APPLIED
  ONLINE_ASSESSMENT
  RECRUITER_SCREEN
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedJobId String   @unique
  savedJob   SavedJob @relation(fields: [savedJobId], references: [id], onDelete: Cascade)

  status            ApplicationStatus @default(SAVED)
  appliedDate       DateTime?
  nextInterviewDate DateTime?
  resumeVersion     String?
  referralContact   String?
  notes             String?           @db.Text
  rejectionStage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
